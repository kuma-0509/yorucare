/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# バイナリの原本・書き出し（本文はテキスト版を追跡する）
*.pdf
*.docx
*.pptx

# ただし docs/ 直下の完成品スライドは、配布したものを残すため追跡する
# （作り直しは docs/slides-src/ のスクリプトで行う）
!/docs/*.pptx

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts
.vercel

# 一時作業ディレクトリ・生成物
/.tmp-ads-deploy/
/outputs/

# 実機テスト用に生成する見本データ（実行した日ごとに作り直す）
/testdata/
yorucare-testdata*.json

# 別リポジトリとして管理している静的サイト
/sites/
