# Neon Postgres の接続文字列。匿名イベント専用DBを分ける場合はこちらを使う。
ANALYTICS_DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# installId / eventId の不可逆化に使う32文字以上の秘密値。
# 本番ではパスワード生成器などで新しい値を作り、リポジトリへ保存しない。
ANALYTICS_ID_SALT=replace-with-at-least-32-random-characters

# Vercel Cronから期限切れデータを削除するための16文字以上の秘密値。
CRON_SECRET=replace-with-at-least-16-random-characters

# --- クラウドバックアップ（既定は無効。同意文面と手続き確認が済むまで開けない） ---

# 本番画面からクラウド保存へ到達できるようにするフラグ。既定は無効。
# NEXT_PUBLIC_CLOUD_BACKUP_ENABLED=true

# 本人記録用Neonプロジェクトの接続文字列。匿名イベント用とは必ず別にする。
# USER_DATA_DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# 記録を暗号化する鍵を包む親鍵。`版:base64の32バイト` をカンマで並べる。
# 先頭が現行の版で、以降は入れ替え中に復号だけへ使う旧版。
# 作り方: node -e "console.log('v1:' + require('node:crypto').randomBytes(32).toString('base64'))"
# USER_DATA_KEK=v1:replace-with-base64-32-bytes

# ダミーデータでの検証用に所有者IDを固定する抜け道。Preview環境だけで使う。
# 本番（VERCEL_ENV=production）では設定されていても無視される。
# USER_DATA_DEV_OWNER_ID=preview-owner-1

# 本人記録用Neonプロジェクトで有効化したManaged Better AuthのベースURL。
# Neon Console の Auth -> Configuration -> Project Info にある「Auth URL」を
# 表示のまま（末尾のパスまで含めて）入れる。2026-09-11時点の形式は
# https://<endpoint>.neonauth.<region>.aws.neon.tech/<database>/auth
# NEON_AUTH_BASE_URL=https://xxxxx.neonauth.c-4.ap-southeast-1.aws.neon.tech/neondb/auth

# セッションCookieの署名鍵。32文字以上の乱数。
# 作り方: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# NEON_AUTH_COOKIE_SECRET=replace-with-at-least-32-random-characters

# 運営者が登録した参加者のメールアドレス一覧（カンマ区切り、大小文字は無視）。
# Managed Better Authは2026-09-08時点で新規登録の抑止をConsole設定だけでは
# 保証していないため、アプリ側でも二重にここへ載っているメールアドレスだけを
# 通す。未設定のときは誰もログインできない（フェイルクローズ）。
# USER_DATA_ALLOWED_EMAILS=sanka1@example.com,sanka2@example.com

