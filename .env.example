# Neon Postgres の接続文字列。匿名イベント専用DBを分ける場合はこちらを使う。
ANALYTICS_DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# installId / eventId の不可逆化に使う32文字以上の秘密値。
# 本番ではパスワード生成器などで新しい値を作り、リポジトリへ保存しない。
ANALYTICS_ID_SALT=replace-with-at-least-32-random-characters

# Vercel Cronから期限切れデータを削除するための16文字以上の秘密値。
CRON_SECRET=replace-with-at-least-16-random-characters
